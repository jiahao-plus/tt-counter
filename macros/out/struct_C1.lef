VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO research_branch
  CLASS BLOCK ;
  ORIGIN 0.930 4.830 ;
  SIZE 10.140 BY 3.240 ;
  SYMMETRY X Y ;
  PIN net
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 0.000 0.100 0.140 0.240 ;
      LAYER met2 ;
        RECT 1.000 2.100 1.140 2.240 ;
      LAYER met2 ;
        RECT 5.000 2.600 5.140 2.740 ;
      LAYER met2 ;
        RECT 9.000 3.100 9.140 3.240 ;
    END
  END net
  OBS
      LAYER met1 ;
        RECT 0.900 0.000 1.240 0.100 ;
        RECT 4.900 0.000 5.240 0.100 ;
        RECT 8.900 0.000 9.240 0.100 ;
        RECT 0.140 0.100 10.140 0.240 ;
        RECT 0.900 0.240 1.240 0.340 ;
        RECT 4.900 0.240 5.240 0.340 ;
        RECT 8.900 0.240 9.240 0.340 ;
      LAYER met2 ;
        RECT 0.900 0.000 1.240 0.340 ;
        RECT 4.900 0.000 5.240 0.340 ;
        RECT 8.900 0.000 9.240 0.340 ;
        RECT 1.000 0.340 1.140 2.100 ;
        RECT 5.000 0.340 5.140 2.600 ;
        RECT 9.000 0.340 9.140 3.100 ;
  END
END research_branch
END LIBRARY
